# Copy this file to .env and adjust the values. Never commit .env.
NODE_ENV=development
PORT=3000

# Local MongoDB (the same address you paste into MongoDB Compass).
# For Atlas or an authenticated server use the full connection string, e.g.
# mongodb+srv://USER:PASSWORD@cluster.mongodb.net/portfolio
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio

# Extra origins allowed to call the API (comma separated). Only needed if you
# open the front end from another dev server such as VS Code Live Server.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Set to true when running behind a reverse proxy (Nginx, Render, Railway...)
TRUST_PROXY=false
